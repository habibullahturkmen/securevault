# TLS 1.3 entry point (proposal §5.1, trust boundary 2).
# For the localhost demo Caddy issues its own local CA certificate
# (`tls internal`); for a real deployment replace `localhost` with the
# domain name and Caddy obtains certificates automatically.

localhost {
	tls internal

	# All security headers, HSTS included, come from the app (ENV=prod) so
	# they exist in exactly one place and survive a change of TLS proxy.
	reverse_proxy app:8080
}
