# Copy to .env and fill in real values. .env is git-ignored; gitleaks guards CI.

# 32-byte hex-encoded master key (KEK). Generate with: make genkey
SECUREVAULT_MASTER_KEY=

# PostgreSQL connection string
DATABASE_URL=postgres://securevault:securevault@localhost:5432/securevault

# Address the API server listens on
LISTEN_ADDR=127.0.0.1:8080

# Directory for the encrypted blob store
DATA_DIR=./data

# Maximum upload size in bytes (default 25 MiB)
MAX_UPLOAD_BYTES=26214400

# dev enables non-Secure cookies for plain-HTTP localhost; use prod behind Caddy TLS
ENV=dev
